{
  "tasks": {
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "test": "deno test --no-prompt --allow-read --allow-run",
    "fmt": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true
  }
}
